# Copy to .env. Everything except SECRET_KEY has a working default.
SECRET_KEY=change-me-to-32+-random-characters
ENVIRONMENT=development              # production => requires a real SECRET_KEY, schema via alembic
DATABASE_URL=sqlite+aiosqlite:///./soc.db   # or postgresql://user:pass@host/db
SEED_DEMO=true                       # demo user admin@example.com / password123 (turn off in production!)
SCHEDULER_ENABLED=true
FEED_INTERVAL_HOURS=6

# AI (optional - agents fall back to rule-based logic without it)
AI_PROVIDER=anthropic                # anthropic | openai | groq | together | ollama | vllm
ANTHROPIC_API_KEY=
# AI_API_KEY= / AI_BASE_URL= / AI_DEFAULT_MODEL=

# Vulnerability feeds / notifications (optional)
NVD_API_KEY=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
FROM_EMAIL=alerts@example.com

# GitHub login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Billing (optional; read straight from the environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
